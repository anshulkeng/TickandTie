# Contact the SEC sees with every request. Must be a real name and email (fair-access rule).
EDGAR_IDENTITY="Your Name your.email@example.com"
# Requests per second to SEC servers. The SEC ceiling is 10; we stay at 5.
SEC_MAX_RPS=5
# Where the local Ollama server listens.
OLLAMA_HOST=http://localhost:11434
# Model that writes answers, and the separate model that grades them in evaluation.
LLM_MODEL=qwen2.5:7b
JUDGE_MODEL=llama3.2:3b
# Embedding model for search.
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Downloaded filings, the facts database and search indexes. Never committed.
DATA_DIR=./data