# Contact the SEC sees with every request. Must be a real name and email (fair-access rule).
EDGAR_IDENTITY="Your Name your.email@example.com"
# Requests per second to SEC servers. The SEC ceiling is 10; we stay at 5.
SEC_MAX_RPS=5
# Where the local Ollama server listens.
OLLAMA_HOST=http://localhost:11434
# Model that writes answers, and the separate model that grades them in evaluation.
LLM_MODEL=qwen2.5:7b
JUDGE_MODEL=llama3.2:3b
# Embedding model for search.
EMBED_MODEL=BAAI/bge-small-en-v1.5
# Downloaded filings, the facts database and search indexes. Never committed.
DATA_DIR=./data
# Language model backend (decision 0019): "ollama" (local, the default) or "openrouter" (hosted).
LLM_BACKEND=ollama
# Hosted model only. Never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct
# Web API (Task 7). Rate limits per visitor and for the whole site.
TICKANDTIE_LIMIT_PER_MINUTE=5
TICKANDTIE_LIMIT_PER_DAY=30
TICKANDTIE_LIMIT_SITE_PER_DAY=500
# Secret used to scramble visitor addresses. Set a long random value in production; never commit it.
TICKANDTIE_IP_SALT=
# Set to 1 only behind a trusted proxy that sets X-Forwarded-For.
TICKANDTIE_TRUST_PROXY=0# Demo mode (decision 0019): seconds before a model call gives up, minutes of demo mode after a failure,
# and 1 to force demo mode (for example before a key is set).
TICKANDTIE_LLM_TIMEOUT=40
TICKANDTIE_DEMO_MINUTES=10
TICKANDTIE_FORCE_DEMO=0# Days to keep submitted questions before they are deleted, and the website origins allowed to call the API.
TICKANDTIE_KEEP_DAYS=7
TICKANDTIE_CORS_ORIGINS=http://localhost:3000